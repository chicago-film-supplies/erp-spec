{
  "name": "@cfs/erp-spec",
  "version": "0.0.0",
  "exports": {},
  "tasks": {
    "validate": "deno run --allow-read --allow-env=SPEC_TODAY tools/validate.ts",
    "triage": "deno run --allow-read --allow-env=SPEC_TODAY tools/validate.ts --triage-only",
    "gen": "deno run --allow-read --allow-write tools/generate.ts",
    "ingest": "deno run --allow-read --allow-write tools/ingest.ts",
    "view": "deno run --allow-read --allow-run --allow-net --allow-env=SPEC_TODAY tools/view.ts",
    "fetch-llms-docs": "deno run --allow-read=.claude/docs --allow-write=.claude/docs --allow-net=docs.deno.com,docs.tigerbeetle.com,duckdb.org,hono.dev,quint.sh,www.mongodb.com,zod.dev tools/fetch-llms-docs.ts"
  },
  "imports": {
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["traceability/", "**/*.generated.*"]
  },
  "lint": {
    "exclude": ["traceability/", "**/*.generated.*"]
  }
}
